APP_ENV=development

# LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://genailab.tcs.in/
OPENAI_MODEL=genailab-openai-gpt-4o
# OpenAI Embeddings
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter (not used)


EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_EMBEDDING_MODEL=


FAISS_TOP_K=5
BM25_TOP_K=5
RRF_K=60
RERANKER_ENABLED=false



# RAG Configuration
FAISS_TOP_K=5
BM25_TOP_K=5
RRF_K=60
RERANKER_ENABLED=false

# Data Storage
DATA_DIR=./data
